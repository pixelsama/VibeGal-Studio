{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "default": "",
      "type": "string"
    },
    "typingSpeedCps": {
      "default": 30,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "autoAdvanceMs": {
      "default": 1200,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chapterGapMs": {
      "default": 1500,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stage": {
      "default": {
        "width": 1280,
        "height": 720
      },
      "type": "object",
      "properties": {
        "width": {
          "default": 1280,
          "type": "integer",
          "minimum": 320,
          "maximum": 7680
        },
        "height": {
          "default": 720,
          "type": "integer",
          "minimum": 180,
          "maximum": 4320
        }
      }
    },
    "locale": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "available": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
          }
        }
      },
      "required": [
        "default",
        "available"
      ],
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "properties": {
        "version": {
          "default": "0.1.0",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "icon": {
          "type": "string",
          "pattern": "^assets\\/[A-Za-z0-9_@+-]+(?:\\.[A-Za-z0-9_@+-]+)*(?:\\/[A-Za-z0-9_@+-]+(?:\\.[A-Za-z0-9_@+-]+)*)*$"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "fit",
                "fill",
                "responsive"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 320,
              "maximum": 7680
            },
            "height": {
              "type": "integer",
              "minimum": 180,
              "maximum": 4320
            }
          },
          "required": [
            "mode",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "updates": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "channel": {
                  "default": "stable",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "channel": {
                  "default": "stable",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "endpoint": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https:\\/\\/.*"
                },
                "publicKey": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "endpoint",
                "publicKey"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
