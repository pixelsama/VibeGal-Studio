{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "entryNodeId": {
      "type": "string"
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "default": {
              "x": 0,
              "y": 0
            },
            "type": "object",
            "properties": {
              "x": {
                "default": 0,
                "type": "number"
              },
              "y": {
                "default": 0,
                "type": "number"
              }
            }
          },
          "chapterId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "file",
          "chapterId"
        ]
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "default": "linear",
            "type": "string",
            "enum": [
              "linear",
              "choice",
              "auto"
            ]
          },
          "label": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "condition": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "set"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Stable story-point id for stoppable/runtime-restorable instructions. Required by validation for say/narrate/wait/pause."
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expr": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "t",
                "key"
              ],
              "additionalProperties": false,
              "x-vibegal": {}
            }
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ]
      }
    }
  },
  "required": [
    "entryNodeId",
    "chapters"
  ]
}
