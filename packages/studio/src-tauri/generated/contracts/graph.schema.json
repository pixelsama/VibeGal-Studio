{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "entryNodeId": {
      "type": "string"
    },
    "chapters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "object",
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "instructionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "vars": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "background": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sprites": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pos": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scale": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 4
                    },
                    "flip": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "pos",
                    "expr"
                  ],
                  "additionalProperties": false
                }
              },
              "bgm": {
                "default": null,
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "loop": {
                        "default": true,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "nodeId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title"
        ]
      }
    },
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "default": {
              "x": 0,
              "y": 0
            },
            "type": "object",
            "properties": {
              "x": {
                "default": 0,
                "type": "number"
              },
              "y": {
                "default": 0,
                "type": "number"
              }
            }
          },
          "chapterId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "file",
          "chapterId"
        ]
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "string",
                  "const": "set"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Stable story-point id for stoppable/runtime-restorable instructions. Required by validation for say/narrate/wait/pause."
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "expr": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "t",
                "key"
              ],
              "additionalProperties": false,
              "x-vibegal": {}
            }
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ]
      }
    }
  },
  "required": [
    "entryNodeId",
    "chapters"
  ]
}
