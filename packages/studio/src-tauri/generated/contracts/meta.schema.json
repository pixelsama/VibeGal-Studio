{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "default": "",
      "type": "string"
    },
    "typingSpeedCps": {
      "default": 30,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "autoAdvanceMs": {
      "default": 1200,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "chapterGapMs": {
      "default": 1500,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stage": {
      "default": {
        "width": 1280,
        "height": 720
      },
      "type": "object",
      "properties": {
        "width": {
          "default": 1280,
          "type": "integer",
          "minimum": 320,
          "maximum": 7680
        },
        "height": {
          "default": 720,
          "type": "integer",
          "minimum": 180,
          "maximum": 4320
        }
      }
    },
    "locale": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "available": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
          }
        }
      },
      "required": [
        "default",
        "available"
      ],
      "additionalProperties": false
    }
  }
}
