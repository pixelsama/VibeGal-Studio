{
  "cases": [
    {
      "id": "node.defaults.bg-bgm-char-say",
      "schema": "nodeFile",
      "input": [
        { "t": "bg", "id": "room" },
        { "t": "bgm", "id": "theme" },
        { "t": "char", "id": "hero" },
        { "t": "say", "id": "line-1", "who": "hero", "text": "Hello" },
        { "t": "inputName", "id": "ask-name", "key": "playerName", "prompt": "Your name?" }
      ],
      "expected": [
        { "t": "bg", "id": "room", "trans": "fade", "ms": 1000 },
        { "t": "bgm", "id": "theme", "fade": 1500, "loop": true },
        { "t": "char", "id": "hero", "pos": "center", "expr": "default", "trans": "fade", "ms": 600, "clear": false, "remove": false, "scale": 1, "flip": false, "exprMs": 0 },
        { "t": "say", "id": "line-1", "who": "hero", "expr": "default", "text": "Hello" },
        { "t": "inputName", "id": "ask-name", "key": "playerName", "prompt": "Your name?", "maxLength": 20 }
      ]
    },
    {
      "id": "manifest.defaults.registries-and-character-color",
      "schema": "manifest",
      "input": {
        "characters": {
          "hero": { "name": "Hero", "sprites": { "default": "hero.png" } }
        },
        "backgrounds": { "room": "room.png" },
        "cg": {},
        "videos": {}
      },
      "expected": {
        "characters": {
          "hero": { "name": "Hero", "color": "#ffffff", "sprites": { "default": "hero.png" } }
        },
        "backgrounds": { "room": "room.png" },
        "audio": { "bgm": {}, "sfx": {}, "voice": {} },
        "cg": {},
        "videos": {},
        "fonts": {},
        "uiSkins": {},
        "animationAtlases": {},
        "unlocks": { "cg": {}, "music": {}, "replay": {}, "endings": {} }
      }
    },
    {
      "id": "meta.defaults.complete-projection",
      "schema": "meta",
      "input": {},
      "expected": {
        "title": "",
        "typingSpeedCps": 30,
        "autoAdvanceMs": 1200,
        "chapterGapMs": 1500,
        "stage": { "width": 1280, "height": 720 }
      }
    },
    {
      "id": "meta.normalizes.locale-tags",
      "schema": "meta",
      "input": {
        "locale": { "default": "ZH-cn", "available": ["ZH-cn", "en"] }
      },
      "expected": {
        "title": "",
        "typingSpeedCps": 30,
        "autoAdvanceMs": 1200,
        "chapterGapMs": 1500,
        "stage": { "width": 1280, "height": 720 },
        "locale": { "default": "zh-CN", "available": ["zh-CN", "en"] }
      }
    },
    {
      "id": "meta.normalizes.distribution-defaults",
      "schema": "meta",
      "input": {
        "title": "Work Title",
        "distribution": {
          "productName": "Package Name",
          "icon": "assets/icon.png",
          "viewport": { "mode": "fill", "width": 1920, "height": 1080 },
          "updates": { "channel": "preview" }
        }
      },
      "expected": {
        "title": "Work Title",
        "typingSpeedCps": 30,
        "autoAdvanceMs": 1200,
        "chapterGapMs": 1500,
        "stage": { "width": 1280, "height": 720 },
        "distribution": {
          "version": "0.1.0",
          "productName": "Package Name",
          "icon": "assets/icon.png",
          "viewport": { "mode": "fill", "width": 1920, "height": 1080 },
          "updates": { "channel": "preview" }
        }
      }
    },
    {
      "id": "locale.preserves.flat-table",
      "schema": "locale",
      "input": { "opening.hello": "Hello" },
      "expected": { "opening.hello": "Hello" }
    },
    {
      "id": "graph.defaults.nodes-and-edges",
      "schema": "graph",
      "input": {
        "entryNodeId": "start",
        "chapters": [{ "id": "chapter_1", "title": "第一章" }],
        "nodes": [{ "id": "start", "file": "nodes/start.json", "chapterId": "chapter_1" }],
        "edges": [{ "id": "loop", "from": "start", "to": "start" }]
      },
      "expected": {
        "version": 1,
        "entryNodeId": "start",
        "chapters": [{ "id": "chapter_1", "title": "第一章" }],
        "nodes": [{ "id": "start", "file": "nodes/start.json", "position": { "x": 0, "y": 0 }, "chapterId": "chapter_1" }],
        "edges": [{ "id": "loop", "from": "start", "to": "start", "mode": "linear", "label": null, "condition": null }]
      }
    },
    {
      "id": "graph.preserves.chapter-metadata",
      "schema": "graph",
      "input": {
        "entryNodeId": "start",
        "chapters": [{ "id": "opening", "title": "序章" }],
        "nodes": [{ "id": "start", "file": "nodes/start.json", "chapterId": "opening" }],
        "edges": []
      },
      "expected": {
        "version": 1,
        "entryNodeId": "start",
        "chapters": [{ "id": "opening", "title": "序章" }],
        "nodes": [{ "id": "start", "file": "nodes/start.json", "position": { "x": 0, "y": 0 }, "chapterId": "opening" }],
        "edges": []
      }
    }
  ]
}
