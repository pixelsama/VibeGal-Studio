[
  { "t": "transition", "type": "fade_in", "ms": 1500 },
  { "t": "bg", "id": "ocean_night", "trans": "fade", "ms": 1200 },
  { "t": "bgm", "id": "bgm_main", "fade": 2500 },

  { "t": "narrate", "id": "prologue_001", "textKey": "prologue.001", "text": "海面没有风。" },
  { "t": "narrate", "id": "prologue_002", "textKey": "prologue.002", "text": "沉在海底的那些东西，偶尔会被潮水推上来。" },
  { "t": "wait", "id": "prologue_003", "ms": 700 },

  { "t": "narrate", "id": "prologue_004", "textKey": "prologue.004", "text": "它们不该有意识。", "ms": 0 },

  { "t": "bg", "id": "ocean_dawn", "trans": "fade", "ms": 2200 },
  { "t": "narrate", "id": "prologue_005", "textKey": "prologue.005", "text": "天快亮了。" },

  { "t": "char", "id": "protagonist", "pos": "right", "expr": "default", "trans": "slide", "ms": 800, "scale": 1.04, "flip": true, "moveFrom": "left" },
  { "t": "narrate", "id": "prologue_006", "textKey": "prologue.006", "text": "她趴在浅滩上，[ruby=睁开]睁开[/ruby]了眼睛。" },

  { "t": "say", "id": "prologue_007", "who": "protagonist", "expr": "default", "textKey": "prologue.007", "text": "……我是谁？", "voice": "prologue_007", "ms": 1800 },
  { "t": "wait", "id": "prologue_008", "ms": 500 },
  { "t": "say", "id": "prologue_009", "who": "protagonist", "expr": "default", "textKey": "prologue.009", "text": "海，浪，[pause=350]还有——[color=#ff6f9f]光[/color]。", "voice": "prologue_009" },

  { "t": "say", "id": "prologue_010", "who": "protagonist", "expr": "default", "textKey": "prologue.010", "text": "我不记得名字。可我好像，知道怎么在水上走。", "voice": "prologue_010" },
  { "t": "inputName", "id": "prologue_name", "key": "playerName", "prompt": "请为与你同行的观察者取一个名字。", "default": "旅人", "maxLength": 12 },
  { "t": "narrate", "id": "prologue_name_echo", "textKey": "prologue.name_echo", "text": "从这一刻起，[b]{playerName}[/b]会记住她的选择。" },

  { "t": "effect", "type": "shake", "intensity": 4, "ms": 300 },
  { "t": "sfx", "id": "sfx_boom" },
  { "t": "narrate", "id": "prologue_011", "textKey": "prologue.011", "text": "远处的火光，映亮了她的脸。" },

  { "t": "char", "id": "protagonist", "pos": "center", "expr": "hurt", "trans": "slide", "ms": 600, "scale": 1.08, "flip": false, "moveFrom": "right", "exprMs": 320 },
  { "t": "say", "id": "prologue_012", "who": "protagonist", "expr": "hurt", "textKey": "prologue.012", "text": "那边……有人在打。", "voice": "prologue_012" },
  { "t": "say", "id": "prologue_013", "who": "protagonist", "expr": "hurt", "textKey": "prologue.013", "text": "我不认识他们。可我不想让他们死。", "voice": "prologue_013" },

  { "t": "char", "id": "protagonist", "pos": "left", "expr": "signal", "trans": "slide", "ms": 700, "scale": 1, "flip": false, "moveFrom": "center", "exprMs": 240 },
  { "t": "narrate", "id": "prologue_014", "textKey": "prologue.014", "text": "她站了起来。海水，主动让开了路。" },

  { "t": "char", "id": "protagonist", "remove": true },
  { "t": "narrate", "id": "prologue_015", "textKey": "prologue.015", "text": "她走向了那片火光。", "ms": 2500 },

  { "t": "transition", "type": "fade_out", "ms": 1500 }
]
